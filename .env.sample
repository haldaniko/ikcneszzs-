COMPOSE_PROJECT_NAME=ikcneszzs
NODE_ENV=production
PORT=4000
POSTGRES_DB=ikcneszzs
POSTGRES_USER=ikcneszzs
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=postgres://ikcneszzs:replace-with-strong-postgres-password@postgres:5432/ikcneszzs
DATABASE_PATH=/workspace/db.sqlite3
REDIS_PASSWORD=replace-with-strong-redis-password
